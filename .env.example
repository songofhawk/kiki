GEMINI_API_KEY=your_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# Ordered comma-separated fallback chain when the primary model hits 503/429 (each model cools down independently)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash,gemini-4-hydrogen
# Optional cooldown window in seconds for overloaded models (default: 120)
# GEMINI_MODEL_COOLDOWN_SECONDS=120

# Paid DeepSeek fallback (auto-used only when Gemini Free Tier models are unavailable/cooling down)
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Zhipu AI (GLM) OpenAI-compatible provider (used for fast structured routing & fallback)
# ZHIPU_API_KEY=your_zhipu_api_key
# ZHIPU_MODEL=glm-4-flash
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional Jev calibrated router provider
# JEV_API_KEY=your_jev_api_key
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai/v1

# Default Heavy-Path adapter: gemini_agent | codex | claude_code | antigravity | deepseek_harness | zcode | kcode | qoder | workbuddy
KIKI_DEFAULT_HEAVY_AGENT=gemini_agent

# Optional CLI binary / model overrides (uncomment as needed)
# KIKI_CODEX_BIN=codex
# KIKI_CODEX_MODEL=gpt-5-codex
# KIKI_CLAUDE_BIN=claude
# KIKI_CLAUDE_MODEL=claude-sonnet-4-6
# KIKI_ANTIGRAVITY_BIN=agy
# KIKI_ANTIGRAVITY_MODEL=gemini-3.8-flash
# KIKI_DEEPSEEK_HARNESS_BIN=dsh
# KIKI_DEEPSEEK_HARNESS_MODEL=deepseek-v4-flash
# KIKI_ZCODE_BIN=zcode
# KIKI_ZCODE_MODEL=glm-5.2
# KIKI_KCODE_BIN=kimi
# KIKI_KCODE_MODEL=kimi-for-coding
# KIKI_QODER_BIN=qoder
# KIKI_QODER_MODEL=qoder-pro
# KIKI_WORKBUDDY_BIN=codebuddy
# KIKI_WORKBUDDY_MODEL=hunyuan-code

# Security: allowed CORS origins (comma-separated, never '*') and optional local Bearer token
# KIKI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# KIKI_API_TOKEN=your_optional_local_bearer_token

# Web Search API Keys (free-tier providers supported with automatic failover)
# KIKI_SEARCH_PROVIDER_ORDER=tavily,serper,exa,jina,brave,bocha,serpapi
# TAVILY_API_KEY=tvly-xxxxxxxx
# SERPER_API_KEY=your_serper_api_key
# EXA_API_KEY=your_exa_api_key
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key
# BOCHA_API_KEY=your_bocha_api_key
# JINA_API_KEY=jina_xxxxxxxx
# SERPAPI_API_KEY=your_serpapi_api_key
